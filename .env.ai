# AURA AI Configuration
# Copy this file to .env and fill in your API keys for real AI responses

# =============================================================================
# AI PROVIDERS — Configure at least one for real AI responses
# =============================================================================

# Local AI (Ollama) — RECOMMENDED for offline use
LOCAL_LFM_BASE_URL=http://localhost:11434
LOCAL_LFM_MODEL=llama3.2:3b

# Gemini AI — Google's most capable model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq AI — Fast inference with open models
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — Unified API for multiple models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-4-maverick

# Hugging Face — Access to thousands of models
HF_TOKEN=your_hf_token_here
HF_MODEL=google/gemma-2-9b-it

# =============================================================================
# PRIORITY ORDER — AI providers are tried in this order
# =============================================================================
# 1. Ollama (local, fastest)
# 2. Gemini (cloud, most capable)
# 3. Groq (cloud, fast)
# 4. OpenRouter (cloud, multi-model)
# 5. HuggingFace (cloud, free tier)
# 6. Local fallback (rule-based, no API needed)

# =============================================================================
# SYSTEM PROMPT — Customize AURA's personality
# =============================================================================
AURA_SYSTEM_PROMPT=Eres AURA, un asistente de IA avanzado. Eres útil, conciso y preciso.
AURA_TEMPERATURE=0.7
AURA_MAX_TOKENS=1024
