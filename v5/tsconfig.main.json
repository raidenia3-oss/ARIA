{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": false,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": false
  },
  "include": ["electron/main.ts"],
  "exclude": ["node_modules", "dist", "dist-electron"]
}