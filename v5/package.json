{
  "name": "aria-os-v5",
  "version": "5.0.0",
  "description": "ARIA OS v5.0 — Electron + React + Three.js Desktop Assistant",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"npm:dev\" \"npm:start\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "build:exe": "npm run build && electron-builder --win",
    "preview": "vite preview",
    "make": "npm run build && electron-builder",
    "start": "electron electron/main.js"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^2.0.0",
    "@electron/remote": "^2.1.3",
    "framer-motion": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "three": "^0.160.0",
    "three-stdlib": "^2.36.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.0.0",
    "jiti": "^2.7.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-tsconfig-paths": "^4.0.0"
  },
  "keywords": [
    "aria",
    "assistant",
    "electron",
    "react",
    "threejs"
  ],
  "author": "ARIA Team",
  "license": "MIT"
}
