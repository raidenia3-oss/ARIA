# .env.cloud (template for production)
# Copy to .env and update values

ENVIRONMENT=production
CLUSTER_MODE=true
LOG_LEVEL=INFO

# Database (from Terraform output)
DATABASE_URL=postgresql://aura_admin:YOUR_DB_PASSWORD@host:5432/aura_db

# Redis (from Terraform output)
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@host:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=YOUR_SECRET_KEY_CHANGE_THIS
AURA_JWT_SECRET=YOUR_JWT_SECRET_CHANGE_THIS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
AURA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://aura.example.com
