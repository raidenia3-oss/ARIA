<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración de seguridad de red local (BLOQUE 40).
     Permite conexiones HTTP/WebSockets directas hacia la IP local de la PC
     sin requerir certificados SSL públicos. No introduce telemetría. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.0/8</domain>
        <domain includeSubdomains="true">172.16.0.0/12</domain>
        <domain includeSubdomains="true">192.168.0.0/16</domain>
        <domain includeSubdomains="true">100.64.0.0/10</domain>
        <trust-anchors>
            <!-- Solo confiar en el sistema (no en certificados de la nube). -->
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>