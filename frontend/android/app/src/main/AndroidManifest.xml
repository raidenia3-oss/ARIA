<?xml version="1.0" encoding="utf-8"?>
<!-- AURA OS AME Android Manifest (Capacitor local wrapper, BLOQUE 40).
     Permisos locales: sin telemetría de Google Play, sin servicios en la nube.
     Almacenamiento SD: requestLegacyExternalStorage + manageExternalStorage
     para acceso directo a la tarjeta SD externa del móvil. -->
<manifest
    package="com.aura.ame"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Almacenamiento local + SD (Android 10+ legacy + Android 11+ manageExternalStorage) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="PermissionName" />

    <!-- Micrófono para notas de voz (STT local Whisper) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="AME"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:ignore="GoogleAppIndexing,MissingApplicationIcon">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboardHidden|keyboardSize|screenSize|smallestScreenSize|uiMode|screenLayout|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter android:label="AME">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Excepción de red local: HTTP/WebSockets directos a la IP de la PC
             (sin certificados SSL públicos). -->
        <meta-data
            android:name="android.app.default_backup_rules"
            android:resource="@xml/backup_rules" />

        <!-- FileProvider para compartir ficheros de la SD -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.aura.ame.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>