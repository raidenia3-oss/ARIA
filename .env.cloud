# .env.cloud (template para prod)
# Copiar a .env y actualizar valores

ENVIRONMENT=production
CLUSTER_MODE=true
LOG_LEVEL=INFO

# Database (desde Terraform output)
DATABASE_URL=postgresql://aura_admin:PASSWORD@host:5432/aura_db

# Redis (desde Terraform output)
REDIS_URL=redis://:PASSWORD@host:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-change-this
AURA_JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
AURA_CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://aura.example.com
