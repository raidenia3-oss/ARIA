{
  "name": "aura-desktop",
  "version": "1.0.0",
  "description": "AURA Desktop App Shell - Native wrapper with system tray, global hotkeys, and frameless translucent window",
  "main": "main.js",
  "author": "AURA OS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "node build.js",
    "pack": "electron-builder build --win --x64",
    "make": "electron-builder build --win --x64",
    "dist": "npm run build"
  },
  "dependencies": {
    "electron": "^31.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "productName": "AURA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "tray.js",
      "shortcuts.js",
      "window.js",
      "backend-manager.py",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "startMenuExtra": [
        "AURA Desktop",
        "AURA Backend"
      ]
    }
  }
}