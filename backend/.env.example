PORT=8000
AURA_BACKEND_URL=http://backend:8000
AURA_API_KEY=
AURA_JWT_SECRET=change-me
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aura
AURA_CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# AI Providers
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=

# Local AI
LOCAL_LFM_BASE_URL=http://localhost:11434
# Keep the local model bounded so AURA does not consume the whole PC.
LOCAL_LFM_MODEL=qwen3:4b
LOCAL_LFM_PRIORITY=1
LOCAL_LFM_TIMEOUT=45
LOCAL_LFM_NUM_CTX=2048
LOCAL_LFM_KEEP_ALIVE=5m

# Omniroute (Multi-Provider AI — 300+ Providers)
OMNIROUTE_URL=http://localhost:8080
OMNIROUTE_TIMEOUT=30
OMNIROUTE_RETRY=3
OMNIROUTE_FALLBACK=true
OMNIROUTE_CONTEXT_RELAY=true
OMNIROUTE_MONITOR_INTERVAL=300

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL=ops

# Redis
REDIS_URL=redis://localhost:6379/0
