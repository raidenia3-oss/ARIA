{
  "name": "aura-copilot",
  "displayName": "AURA Copilot",
  "description": "AURA Copilot - AI assistant with voice and multimodal capabilities",
  "version": "1.0.0",
  "publisher": "aura",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "aura",
    "ai",
    "copilot",
    "voice",
    "multimodal"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aura.toggleVoice",
        "title": "AURA: Toggle Voice Input"
      },
      {
        "command": "aura.sendToCopilot",
        "title": "AURA: Send Selection to Copilot"
      }
    ],
    "keybindings": [
      {
        "command": "aura.toggleVoice",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "node-record-lpcm16": "^1.0.1"
  }
}
