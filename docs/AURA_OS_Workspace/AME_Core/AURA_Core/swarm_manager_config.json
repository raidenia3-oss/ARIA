    "strategy_weights": {
        "signal_strength": 0.4,
        "cpu_load": 0.3,
        "battery_level": 0.2,
        "distance": 0.1
    },
    "task_coordination_interval": 30,
    "error_retry_delay": 60,
    "log_file": "/data/data/com.termux/files/home/swarm_manager.log",
    "enable_visualization": true,
    "visualization_update_interval": 60,
    "enable_task_coordination": true,
    "task_priority_weights": {
        "critical": 1.0,
        "high": 0.8,
        "medium": 0.5,
        "low": 0.2
    },
    "node_selection_criteria": [
        "signal_strength",
        "cpu_load",
        "battery_level",
        "disk_space",
        "capabilities"
    ],
    "last_updated": "2026-06-02T00:00:00Z",
    "swarm_capabilities": {
        "osint_tools": 3,
        "wifi_scan": 4,
        "network_analysis": 2,
        "module_execution": 3,
        "battery_monitoring": 4,
        "security_audit": 1,
        "network_capture": 2
    },
    "geolocation": {
        "enabled": true,
        "server_latitude": -12.0464,
        "server_longitude": -77.0428,
        "max_distance_km": 50
    },
    "security_settings": {
        "enable_node_authentication": true,
        "require_ssl": true,
        "api_rate_limit": 100,
        "rate_limit_window": 60,
        "enable_audit_logging": true,
        "audit_log_retention": 30
    },
    "task_types": {
        "OSINT_SCAN": {
            "description": "Escaneo OSINT utilizando múltiples herramientas",
            "requirements": ["osint_tools"],
            "priority": "high",
            "default_parameters": {
                "target": "example.com",
                "tools": ["PhantomOSINT", "SubdomainEnumeration"],
                "depth": 2,
                "timeout": 300
            }
        },
        "WIFI_SCAN": {
            "description": "Escaneo de redes WiFi disponibles y dispositivos conectados",
            "requirements": ["wifi_scan"],
            "priority": "medium",
            "default_parameters": {
                "network": "2.4GHz",
                "scan_type": "active",
                "duration": 60,
                "target_ssids": []
            }
        },
        "NETWORK_ANALYSIS": {
            "description": "Análisis completo de la red local en busca de dispositivos no autorizados",
            "requirements": ["network_analysis"],
            "priority": "medium",
            "default_parameters": {
                "interface": "eth0",
                "scan_duration": 120,
                "detect_rogue_devices": true,
                "check_for_malware": true
            }
        },
        "MODULE_EXECUTION": {
            "description": "Ejecutar un módulo Venice en el dispositivo móvil",
            "requirements": ["module_execution"],
            "priority": "medium",
            "default_parameters": {
                "module_name": "osint_module.py",
                "module_args": ["--target", "target.com", "--depth", "2"],
                "timeout": 600
            }
        },
        "BATTERY_MONITORING": {
            "description": "Monitoreo continuo del nivel de batería del dispositivo",
            "requirements": ["battery_monitoring"],
            "priority": "low",
            "default_parameters": {
                "interval": 3600,
                "threshold": 20,
                "duration": 86400
            }
        },
        "SECURITY_AUDIT": {
            "description": "Auditoría de seguridad del sistema del dispositivo",
            "requirements": ["security_audit"],
            "priority": "high",
            "default_parameters": {
                "check_open_ports": true,
                "scan_vulnerabilities": true,
                "check_firewall": true
            }
        },
        "NETWORK_CAPTURE": {
            "description": "Captura y análisis de tráfico de red",
            "requirements": ["network_capture", "packet_analysis"],
            "priority": "high",
            "default_parameters": {
                "interface": "wlan0",
                "filter": "tcp port 80 or port 443",
                "duration": 300,
                "output_file": "/tmp/network_capture.pcap"
            }
        },
        "MASSIVE_WIFI_SCAN": {
            "description": "Escaneo masivo de redes WiFi en múltiples nodos",
            "requirements": ["wifi_scan"],
            "priority": "critical",
            "default_parameters": {
                "networks": ["2.4GHz", "5GHz"],
                "scan_type": "active",
                "duration": 120,
                "target_ssids": [],
                "consolidate_results": true
            }
        },
        "DISTRIBUTED_OSINT": {
            "description": "Escaneo OSINT distribuido en múltiples nodos",
            "requirements": ["osint_tools"],
            "priority": "critical",
            "default_parameters": {
                "targets": ["example.com", "test.com"],
                "tools": ["PhantomOSINT", "SubdomainEnumeration"],
                "depth": 3,
                "timeout": 600,
                "parallel_nodes": 3
            }
        }
    },
