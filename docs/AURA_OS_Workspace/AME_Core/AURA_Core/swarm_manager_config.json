        },
        "geographic": {
            "description": "Asigna tareas al nodo más cercano geográficamente",
            "reference_point": {
                "latitude": -12.0464,
                "longitude": -77.0428
            }
        },
        "capability_specific": {
            "description": "Asigna tareas a nodos específicos según sus capacidades",
            "mappings": {
