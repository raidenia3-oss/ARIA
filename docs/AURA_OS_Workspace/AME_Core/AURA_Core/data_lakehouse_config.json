    "alerting_system": {
        "enabled": true,
        "alert_types": [
            {"type": "device_anomaly", "description": "Comportamiento anómalo detectado en un dispositivo"},
            {"type": "threat_detection", "description": "Amenaza potencial detectada"},
            {"type": "device_relationship", "description": "Relación sospechosa entre dispositivos"},
            {"type": "data_exfiltration", "description": "Posible exfiltración de datos detectada"},
            {"type": "configuration_issue", "description": "Problema de configuración que podría ser explotado"},
            {"type": "unauthorized_access", "description": "Intento de acceso no autorizado detectado"}
        ],
        "notification_channels": [
            {"type": "email", "enabled": true, "recipients": ["security@aura-system.com", "threat_intel@aura-system.com"]},
            {"type": "slack", "enabled": true, "webhook_url": "https://hooks.slack.com/services/XXX/YYY/ZZZ", "channel": "#security-alerts"},
            {"type": "dashboard", "enabled": true, "endpoint": "/api/alerts/notifications"},
            {"type": "sms", "enabled": false, "phone_numbers": ["+51987654321"]},
            {"type": "push_notification", "enabled": true, "endpoint": "/api/notifications/push"}
        ],
        "severity_mapping": {
            "critical": {"priority": 1, "notification_channels": ["email", "slack", "dashboard", "push_notification"]},
            "high": {"priority": 2, "notification_channels": ["email", "slack", "dashboard"]},
            "medium": {"priority": 3, "notification_channels": ["email", "dashboard"]},
            "low": {"priority": 4, "notification_channels": ["dashboard"]}
        },
        "alert_escalation": {
            "enabled": true,
            "escalation_rules": [
                {
                    "condition": "severity == 'critical' && no_response_within_minutes(30)",
                    "actions": ["notify_security_team_lead", "escalate_to_incident_manager"]
                },
                {
                    "condition": "severity == 'high' && no_response_within_minutes(60)",
                    "actions": ["notify_security_team_lead"]
                },
                {
                    "condition": "device.risk_score > 80 && device.threat_level == 'critical'",
                    "actions": ["quarantine_device", "notify_all_analysts"]
                }
            ],
            "response_time_tracking": {
                "enabled": true,
                "acknowledgment_timeout": 1440,
                "resolution_timeout": 43200
            }
        },
        "alert_suppression": {
            "enabled": true,
            "suppression_rules": [
                {
                    "type": "duplicate_alerts",
                    "description": "Suprimir alertas duplicadas de los mismos dispositivos",
                    "window_minutes": 30,
                    "threshold": 3
                },
                {
                    "type": "low_severity_noise",
                    "description": "Suprimir alertas de baja severidad que no requieren acción",
                    "severity_level": "low",
                    "frequency_threshold": 10
                },
                {
                    "type": "known_false_positives",
                    "description": "Suprimir alertas de dispositivos conocidos como seguros",
                    "device_list": ["known_secure_device_001", "known_secure_device_002"]
                }
            ]
        }
    },
    "data_quality": {
        "enabled": true,
        "data_validation": {
            "enabled": true,
            "validation_rules": [
