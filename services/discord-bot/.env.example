# =============================================================================
# AURA Discord Bot — env template  (NEVER commit real tokens)
# -----------------------------------------------------------------------------
# Copia a `.env` y rellena con valores de producción. .gitignore excluye .env
# y .env.local. No uses .env.example con secrets.
#
# Fuente de carga:
#   - backend/main.py      -> load_dotenv("services/discord-bot/.env", override=False)
#   - scripts/start-discord-bot.rb -> Dotenv.load("../services/discord-bot/.env")
# =============================================================================

# --- Discord ---
# Token del bot (Bot -> OAuth2 -> Token). Formato: 3 partes '.' (~59 chars).
# El backend enmascara nunca revela el valor (ver /api/discord/diagnostics).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL=ops
DISCORD_VAULT_CHANNEL=
DISCORD_VOICE_CHANNEL_ID=

# --- AURA Backend ---
AURA_BACKEND_URL=http://localhost:8000
AURA_API_KEY=
AURA_AUTH_TOKEN=
AURA_BEARER_TOKEN=

# --- Redis (opcional: tolera caída, encola en memoria) ---
REDIS_URL=redis://localhost:6379/0

# --- Opcional ---
# DISCORD_RECORD_CONNECTION=true
